# LANDA learner frontend — safe template committed to Git.
# Do not put database URLs, service keys, private IPs/domains, or OAuth client
# secrets in VITE_* values: Vite embeds them in the browser bundle.

# Public browser settings. Leave VITE_API_BASE_URL empty for same-origin /api.
VITE_API_BASE_URL=
VITE_LMS_BASE_URL=
VITE_STUDIO_BASE_URL=
VITE_API_TIMEOUT_MS=30000
VITE_TOKEN_REFRESH_BUFFER_MS=300000
VITE_MICROSOFT_CLIENT_ID=
VITE_KEYCLOAK_CLIENT_ID=

# Server-side preview/proxy settings. Fill only in ignored local env files.
API_BACKEND_URL=
PROXY_BACKEND_URL=
VITE_ALLOWED_HOSTS=
VITE_PREVIEW_PORT=5173
